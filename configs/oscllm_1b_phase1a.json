{
  "_comment": "OSCLLM Phase 1a: 流程验证配置 (D=384, L=16, ~84M params)",
  
  "model": {
    "vocab_size": 512,
    "d_model": 384,
    "num_heads": 12,
    "num_layers": 16,
    "seq_len": 4096,
    "max_seq_len": 4096,
    "dropout": 0.0,
    "bias": false,
    "d_ff": 1536,
    
    "cfra": {
      "gamma": 0.1,
      "use_spectral_filter": true,
      "frequency_penalty": 0.1
    },
    
    "ltk": {
      "tau_max": 5,
      "dt": 0.1,
      "alpha": 2.0,
      "hidden_dim": 384,
      "use_adaptive_steps": true
    },
    
    "sfr": {
      "spike_target": 0.3,
      "beta": 0.9,
      "threshold_init": 0.5,
      "aux_loss_weight": 0.01,
      "use_ste": true
    },
    
    "mux": {
      "gate_type": "learned",
      "temperature": 1.0
    }
  },
  
  "_pretrain": {
    "total_tokens": 1000000000,
    "seq_len": 4096,
    "micro_batch_tokens": 524288,
    "grad_accum_steps": 4,
    "lr": 3e-4,
    "min_lr": 1e-5,
    "warmup_steps": 1000,
    "total_steps": 25000,
    "max_grad_norm": 1.0,
    "grad_checkpointing": true
  },
  
  "_data": {
    "source": "modelscope/chinese-c4",
    "streaming": true,
    "target_shards": 3,
    "max_tokens": 1050000000,
    "shuffle_buffer": 10000
  },
  
  "_monitor": {
    "logging_steps": 10,
    "save_steps": 1000,
    "eval_steps": 500,
    "log_dir": "/home/dja/桌面/Test Train OSC-LLM/runs"
  }
}
